page {
    min-height: 100%;
    background-color: #14201b;
    background-image: radial-gradient(circle at 18% 8%, rgba(143, 211, 192, 0.08), transparent 42%),
        radial-gradient(circle at 82% 92%, rgba(233, 217, 139, 0.06), transparent 46%);
    color: #eef3ea;
    font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    font-size: 30rpx;
    line-height: 1.5;
}

button {
    border-radius: 16rpx;
    font-size: 30rpx;
}

button::after {
    border: none;
}

.panel {
    background: #1b2a23;
    border: 2rpx solid rgba(238, 243, 234, 0.12);
    border-radius: 20rpx;
}

.dim {
    color: rgba(238, 243, 234, 0.55);
}

.chalk-line {
    height: 2rpx;
    background: rgba(238, 243, 234, 0.12);
}

.btn-primary {
    background: #e9d98b;
    color: #1a241e;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.btn-ghost {
    background: transparent;
    color: #eef3ea;
    border: 2rpx solid rgba(238, 243, 234, 0.28);
}
